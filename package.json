{
  "name": "get3d-redesign",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "sync:css": "python scripts/build_tailwind_layers.py",
    "sync:js": "node -e \"import fs from 'fs'; fs.mkdirSync('public/js',{recursive:true}); fs.copyFileSync('js/main.js','public/js/main.js');\"",
    "build": "npm run sync:css && python scripts/sync_public_assets.py && npm run sync:js && astro build",
    "preview": "astro preview",
    "bootstrap:sections": "python scripts/bootstrap_astro.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^5.7.10",
    "tailwindcss": "^4.3.5"
  }
}
