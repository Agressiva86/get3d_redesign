---
const sectionClass =
  "mx-5 w-[calc(100%-40px)] rounded-[22px] bg-stone-50 px-[max(10px,calc((100%-1500px)/2-20px))] py-9 pb-12 text-left max-[640px]:pt-[42px] min-[641px]:max-[980px]:mx-[30px] min-[641px]:max-[980px]:w-[calc(100%-60px)] min-[641px]:max-[980px]:rounded-none min-[641px]:max-[980px]:bg-transparent min-[641px]:max-[980px]:px-0 min-[641px]:max-[980px]:py-0 min-[641px]:max-[980px]:pb-10";

const layoutClass =
  "hero-layout grid w-full grid-cols-[minmax(0,1.05fr)_minmax(0,1.15fr)_285px] items-stretch gap-[22px] max-[980px]:grid-cols-1 min-[641px]:max-[980px]:gap-6";

const copyClass =
  "hero-copy @container flex w-full min-w-0 flex-col justify-center py-3 pr-2 pl-0 max-[980px]:pr-0 min-[641px]:max-[980px]:rounded-[22px] min-[641px]:max-[980px]:bg-stone-50 min-[641px]:max-[980px]:p-[30px]";

const h1Class =
  "mt-[22px] max-w-[520px] max-[980px]:max-w-none text-[clamp(32px,12.2cqw,58px)] font-semibold leading-[1.05]";

const leadClass = "mt-[18px] max-w-[440px] max-[980px]:max-w-none text-[17px]";

const actionsClass =
  "hero-actions mt-7 flex flex-wrap justify-start gap-6 max-[640px]:flex-col max-[640px]:gap-2.5";

const stageClass =
  "hero-stage @container relative min-h-[540px] overflow-hidden rounded-[22px] bg-stone-200 max-[980px]:min-h-[420px]";

const stageImgClass =
  "absolute inset-0 m-0 h-full w-full max-w-none select-none object-cover object-center";

const markClass =
  "hero-mark pointer-events-none absolute top-[18px] right-[18px] z-[2] h-[21px] w-7 fill-white [&_path:nth-child(1)]:opacity-50 [&_path:nth-child(2)]:opacity-30 [&_path:nth-child(3)]:opacity-10";

const floatClass =
  "hero-float absolute top-[16%] right-[18px] w-[196px] rounded-[22px] border border-white/20 bg-[rgba(21,0,41,0.34)] pt-[18px] pr-4 pb-4 pl-[18px] shadow-[0_10px_28px_rgba(20,18,15,0.16)] backdrop-blur-[18px] backdrop-saturate-[1.45]";

const floatStrongClass =
  "block font-display text-[32px] font-medium leading-none tracking-normal text-white";

const floatSpanClass = "mt-2.5 block font-display text-[13px] font-normal leading-[1.35] text-white";

const captionClass =
  "hero-caption absolute inset-x-0 bottom-0 z-[1] flex flex-col items-start gap-2 pt-[92px] pr-[22px] pb-5 pl-[22px] before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:bg-gradient-to-t before:from-[rgba(21,0,41,0.55)] before:from-0% before:via-[rgba(21,0,41,0.32)] before:via-[55%] before:to-transparent before:to-100% before:backdrop-blur-[16px] before:backdrop-saturate-[1.4] before:[mask-image:linear-gradient(to_top,#000_0%,#000_52%,transparent_100%)] before:[-webkit-mask-image:linear-gradient(to_top,#000_0%,#000_52%,transparent_100%)]";

const captionTitleClass =
  "m-0 w-[calc(70cqw-22px)] max-w-full font-display text-[26px] font-medium leading-[1.05] tracking-normal text-white max-[980px]:w-full";

const captionTextClass =
  "m-0 w-[calc(70cqw-22px)] max-w-full text-[13px] leading-[1.4] text-white max-[980px]:w-full";

const captionActionsClass =
  "hero-caption-actions mt-1.5 flex w-auto max-w-full flex-wrap gap-2 max-[980px]:w-full";

const captionBtnBase = "hero-caption-btn";

const captionBtnSolid = "hero-caption-btn-solid";

const captionBtnLineIcon = "hero-caption-btn-line";

const railClass =
  "hero-rail flex w-[285px] max-w-[285px] flex-col max-[980px]:w-full max-[980px]:max-w-none";

const sliderClass = "hero-slider flex h-auto w-full flex-1 flex-col bg-transparent max-[980px]:w-full";

const viewportClass =
  "hero-slider-viewport flex-none cursor-grab overflow-visible bg-transparent touch-pan-y [clip-path:inset(0_round_22px)] max-[980px]:overflow-hidden max-[980px]:[clip-path:none] [&.is-grabbing]:cursor-grabbing [&.is-grabbing_.hero-slide]:cursor-grabbing [&.is-grabbing_.hero-slide]:select-none";

const trackClass =
  "hero-slider-track relative block h-auto transition-[height] duration-[650ms] ease-[cubic-bezier(0.22,1,0.36,1)] max-[980px]:flex max-[980px]:w-full max-[980px]:gap-3.5 max-[980px]:transition-transform max-[980px]:duration-[550ms] max-[980px]:ease-[cubic-bezier(0.22,1,0.36,1)]";

const slideClass =
  "hero-slide group relative top-auto left-auto flex min-w-0 w-[calc((100%-14px)/2)] flex-[0_0_calc((100%-14px)/2)] cursor-pointer flex-col rounded-[22px] bg-white p-4 min-[981px]:absolute min-[981px]:top-0 min-[981px]:left-0 min-[981px]:w-full min-[981px]:flex-[0_0_100%] max-[640px]:w-full max-[640px]:flex-[0_0_100%] [transform-style:preserve-3d] [transition:transform_0.55s_cubic-bezier(0.22,1,0.36,1),opacity_0.45s_ease,--hero-shade_0.55s_linear] min-[981px]:first:relative [&_.card-details]:before:absolute [&_.card-details]:before:inset-0 [&_.card-details]:before:z-[1] [&_.card-details]:before:content-[''] [&_.mega-cart]:relative [&_.mega-cart]:z-[2] after:pointer-events-none after:absolute after:inset-0 after:z-[4] after:rounded-[inherit] after:bg-black after:opacity-[var(--hero-shade,0)] after:content-[''] [&_.product-shot_img]:aspect-square [&_.product-shot_img]:h-auto [&_.product-shot_img]:w-full [&_.product-shot_img]:rounded-lg [&_.product-shot_img]:bg-stone-50 [&_.product-shot_img]:object-contain [&_.product-shot_img]:transition-transform [&_.product-shot_img]:duration-[650ms] [&_.product-shot_img]:ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:[&_.product-shot_img]:scale-105";
---

<style is:global>
  @property --hero-shade {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
  }
  @media (min-width: 981px) {
    .hero-slider.is-ready .hero-slide,
    .hero-slider.is-ready .hero-slide:first-child {
      position: absolute;
    }
  }
</style>

<section class={sectionClass}>
  <div class={layoutClass}>
    <div class={copyClass}>
      <span class="eyebrow"><i>nowości</i> drukarki 3D</span>
      <h1 class={h1Class}>Drukarki 3D, filamenty i akcesoria dla profesjonalistów</h1>
      <p class={leadClass}>
        Wybierz sprawdzone drukarki 3D, filamenty, żywice i części zamienne od wiodących producentów. Doradzamy,
        wdrażamy i serwisujemy rozwiązania do druku 3D dla firm, pracowni i inżynierów.
      </p>
      <div class={actionsClass}>
        <a class="btn btn-dark" href="#drukarki">Zobacz bestsellery!</a>
        <a class="btn btn-line" href="#kontakt">Zapytaj o ofertę!</a>
      </div>
    </div>

    <div class={stageClass}>
      <img class={stageImgClass} src="assets/hero-drukarka.webp" alt="Drukarka Bambu Lab na stanowisku w pracowni" />
      <svg class={markClass} viewBox="105.9 0.4 32.3 23.8" aria-hidden="true">
        <path
          d="M138 3.09999C138.089 4.62816 137.197 5.8507 135.635 6.24366H111.899C110.382 6.19999 109.311 4.67183 109.267 3.3183C109.267 2.00845 110.338 0.436615 111.899 0.436615H135.368C136.885 0.436615 137.911 1.87746 138 3.09999Z"
        ></path>
        <path
          d="M128.72 12.1817C128.72 13.6662 127.827 14.8887 126.266 15.238H110.293C108.776 15.1944 107.661 13.7535 107.616 12.4C107.571 11.0465 108.642 9.431 110.204 9.431H126.132C127.649 9.431 128.63 10.9155 128.72 12.1817Z"
        ></path>
        <path
          d="M119.529 23.1408C119.038 23.7084 118.19 24.1451 117.253 24.1451H108.776C107.214 24.1451 106.054 22.7915 105.965 21.3507C105.92 19.9535 106.947 18.3817 108.553 18.3817H117.789C118.949 18.3817 119.886 19.5606 120.109 20.6084C120.332 21.569 120.109 22.4422 119.529 23.1408Z"
        ></path>
      </svg>
      <aside class={floatClass}>
        <strong class={floatStrongClass}>20k+</strong>
        <span class={floatSpanClass}>sprzedanych drukarek 3D przez get3D.</span>
      </aside>
      <div class={captionClass}>
        <h2 class={captionTitleClass}>Nowe Bambu Lab do domu</h2>
        <p class={captionTextClass}>
          Maszyna, filament i akcesoria w jednym miejscu. Od pierwszego wydruku po codzienną serię.
        </p>
        <div class={captionActionsClass}>
          <a class={`${captionBtnBase} ${captionBtnSolid}`} href="#drukarki">Najczęściej kupowane drukarki</a>
          <a class={`${captionBtnBase} ${captionBtnLineIcon}`} href="#cennik"
            ><span class="icon icon-percent" aria-hidden="true"></span>Promocje Bambu Lab!</a
          >
        </div>
      </div>
    </div>

    <div class={railClass}>
      <div class={sliderClass} data-hero-slider>
        <div class={viewportClass}>
          <div class={trackClass}>
            <article class={slideClass}>
              <div class="product-shot overflow-hidden rounded-lg bg-stone-50">
                <img src="assets/drukarka-3d-bambu-lab-a1-combo.webp" alt="Drukarka 3D Bambu Lab A1 Combo" />
                <span class="variant-count">3 warianty</span>
              </div>
              <p class="hero-slide-name">Bambu Lab A1 Combo</p>
              <ul class="product-badges">
                <li>256×256×256 mm</li>
                <li>AMS</li>
                <li>WiFi</li>
                <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
              </ul>
              <div class="mega-buy">
                <p class="mega-price">
                  <span class="mega-amount"><small>od</small> 1&nbsp;160<sup>00</sup> <span class="mega-currency">zł</span></span>
                  <span class="mega-save">-150&nbsp;zł</span>
                </p>
                <div class="card-actions">
                  <a class="mini-link card-details" href="#drukarki">Szczegóły</a>
                  <a class="mega-cart mega-cart-variant" href="#drukarki">
                    <span class="icon icon-layers" aria-hidden="true"></span> Wybierz wariant
                  </a>
                </div>
                <p class="mega-low">Najniższa cena: 1&nbsp;310,00&nbsp;zł</p>
              </div>
            </article>
            <article class={slideClass}>
              <div class="product-shot overflow-hidden rounded-lg bg-stone-50">
                <img src="assets/drukarka-3d-bambu-lab-a1-combo.webp" alt="Drukarka 3D Bambu Lab A1" />
                <span class="variant-count">2 warianty</span>
              </div>
              <p class="hero-slide-name">Bambu Lab A1</p>
              <ul class="product-badges">
                <li>256×256×256 mm</li>
                <li>AMS</li>
                <li>WiFi</li>
                <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
              </ul>
              <div class="mega-buy">
                <p class="mega-price">
                  <span class="mega-amount"><small>od</small> 1&nbsp;160<sup>00</sup> <span class="mega-currency">zł</span></span>
                </p>
                <div class="card-actions">
                  <a class="mini-link card-details" href="#drukarki">Szczegóły</a>
                  <a class="mega-cart mega-cart-variant" href="#drukarki">
                    <span class="icon icon-layers" aria-hidden="true"></span> Wybierz wariant
                  </a>
                </div>
              </div>
            </article>
            <article class={slideClass}>
              <div class="product-shot overflow-hidden rounded-lg bg-stone-50">
                <img src="assets/drukarka-3d-bambu-lab-a1-combo.webp" alt="Drukarka 3D Bambu Lab A1 mini" />
                <span class="variant-count">4 warianty</span>
              </div>
              <p class="hero-slide-name">Bambu Lab A1 mini</p>
              <ul class="product-badges">
                <li>180×180×180 mm</li>
                <li>AMS</li>
                <li>WiFi</li>
                <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
              </ul>
              <div class="mega-buy">
                <p class="mega-price">
                  <span class="mega-amount"><small>od</small> 845<sup>00</sup> <span class="mega-currency">zł</span></span>
                </p>
                <div class="card-actions">
                  <a class="mini-link card-details" href="#drukarki">Szczegóły</a>
                  <a class="mega-cart mega-cart-variant" href="#drukarki">
                    <span class="icon icon-layers" aria-hidden="true"></span> Wybierz wariant
                  </a>
                </div>
              </div>
            </article>
            <article class={slideClass}>
              <div class="product-shot overflow-hidden rounded-lg bg-stone-50">
                <img src="assets/drukarka-3d-bambu-lab-a1-combo.webp" alt="Drukarka 3D Bambu Lab X2D Combo" />
              </div>
              <p class="hero-slide-name">Bambu Lab X2D Combo</p>
              <ul class="product-badges">
                <li>256×256×260 mm</li>
                <li>AMS</li>
                <li>WiFi</li>
                <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
              </ul>
              <div class="mega-buy">
                <p class="mega-price">
                  <span class="mega-amount">3&nbsp;379<sup>00</sup> <span class="mega-currency">zł</span></span>
                  <span class="mega-save">-400&nbsp;zł</span>
                </p>
                <div class="card-actions">
                  <a class="mini-link card-details" href="#drukarki">Szczegóły</a>
                  <button class="mega-cart" type="button" data-add data-id="x2d-combo" data-name="Bambu Lab X2D Combo" data-price="3379">
                    <span class="icon icon-cart" aria-hidden="true"></span> Kup teraz
                  </button>
                </div>
                <p class="mega-low">Najniższa cena: 3&nbsp;779,00&nbsp;zł</p>
              </div>
            </article>
            <article class={slideClass}>
              <div class="product-shot overflow-hidden rounded-lg bg-stone-50">
                <img src="assets/bambu-lab-ams-2-pro.webp" alt="Bambu Lab AMS 2 Pro" />
              </div>
              <p class="hero-slide-name">Bambu Lab AMS 2 Pro – Automatic Material System</p>
              <ul class="product-badges">
                <li>372×280×226 mm</li>
                <li>Suszenie 65°C</li>
                <li>RFID</li>
                <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
              </ul>
              <div class="mega-buy">
                <p class="mega-price">
                  <span class="mega-amount">990<sup>00</sup> <span class="mega-currency">zł</span></span>
                  <span class="mega-save">-300&nbsp;zł</span>
                </p>
                <div class="card-actions">
                  <a class="mini-link card-details" href="https://get3d.pl/drukarki-3d/bambu-lab-ams-2-pro/">Szczegóły</a>
                  <button class="mega-cart" type="button" data-add data-id="ams-2-pro" data-name="Bambu Lab AMS 2 Pro" data-price="990">
                    <span class="icon icon-cart" aria-hidden="true"></span> Kup teraz
                  </button>
                </div>
                <p class="mega-low">Najniższa cena: 1&nbsp;110,00&nbsp;zł</p>
              </div>
            </article>
          </div>
        </div>
        <div class="hero-slider-bar">
          <button class="hero-slider-arrow" type="button" data-hero-dir="-1" aria-label="Poprzedni produkt">
            <span class="icon icon-back" aria-hidden="true"></span>
          </button>
          <div class="hero-slider-dots">
            <button type="button" class="is-on" data-hero-go="0" aria-label="Bambu Lab A1 Combo"></button>
            <button type="button" data-hero-go="1" aria-label="Bambu Lab A1"></button>
            <button type="button" data-hero-go="2" aria-label="Bambu Lab A1 mini"></button>
            <button type="button" data-hero-go="3" aria-label="Bambu Lab X2D Combo"></button>
            <button
              type="button"
              data-hero-go="4"
              aria-label="Bambu Lab AMS 2 Pro – Automatic Material System"
            ></button>
          </div>
          <button class="hero-slider-arrow" type="button" data-hero-dir="1" aria-label="Następny produkt">
            <span class="icon icon-arrow" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>