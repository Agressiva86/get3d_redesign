---
---
<section class="hero">
<div class="wrap hero-layout">
        <div class="hero-copy">
          <span class="eyebrow"><i>nowości</i> drukarki 3D</span>
          <h1>Drukarki 3D, filamenty i akcesoria dla profesjonalistów</h1>
          <p class="lead">Wybierz sprawdzone drukarki 3D, filamenty, żywice i części zamienne od wiodących producentów. Doradzamy, wdrażamy i serwisujemy rozwiązania do druku 3D dla firm, pracowni i inżynierów.</p>
          <div class="hero-actions">
            <a class="btn btn-dark" href="#drukarki">Zobacz bestsellery!</a>
            <a class="btn btn-line" href="#kontakt">Zapytaj o ofertę!</a>
          </div>
        </div>

        <div class="hero-stage">
          <img src="assets/hero-drukarka.webp" alt="Drukarka Bambu Lab na stanowisku w pracowni">
          <svg class="hero-mark" viewBox="105.9 0.4 32.3 23.8" aria-hidden="true">
            <path d="M138 3.09999C138.089 4.62816 137.197 5.8507 135.635 6.24366H111.899C110.382 6.19999 109.311 4.67183 109.267 3.3183C109.267 2.00845 110.338 0.436615 111.899 0.436615H135.368C136.885 0.436615 137.911 1.87746 138 3.09999Z"/>
            <path d="M128.72 12.1817C128.72 13.6662 127.827 14.8887 126.266 15.238H110.293C108.776 15.1944 107.661 13.7535 107.616 12.4C107.571 11.0465 108.642 9.431 110.204 9.431H126.132C127.649 9.431 128.63 10.9155 128.72 12.1817Z"/>
            <path d="M119.529 23.1408C119.038 23.7084 118.19 24.1451 117.253 24.1451H108.776C107.214 24.1451 106.054 22.7915 105.965 21.3507C105.92 19.9535 106.947 18.3817 108.553 18.3817H117.789C118.949 18.3817 119.886 19.5606 120.109 20.6084C120.332 21.569 120.109 22.4422 119.529 23.1408Z"/>
          </svg>
          <aside class="hero-float">
            <strong>20k+</strong>
            <span>sprzedanych drukarek 3D przez get3D.</span>
          </aside>
          <div class="hero-caption">
            <h2>Nowe Bambu Lab do domu</h2>
            <p>Maszyna, filament i akcesoria w jednym miejscu. Od pierwszego wydruku po codzienną serię.</p>
            <div class="hero-caption-actions">
              <a class="hero-caption-btn hero-caption-btn-solid" href="#drukarki">Najczęściej kupowane drukarki</a>
              <a class="hero-caption-btn hero-caption-btn-line" href="#cennik"><span class="icon icon-percent" aria-hidden="true"></span>Promocje Bambu Lab!</a>
            </div>
          </div>
        </div>

        <div class="hero-rail">
          <div class="hero-slider" data-hero-slider>
            <div class="hero-slider-viewport">
              <div class="hero-slider-track">
                <article class="hero-slide">
                  <div class="product-shot">
                    <img src="assets/drukarka-3d-bambu-lab-a1-combo.webp" alt="Drukarka 3D Bambu Lab A1 Combo">
                    <span class="variant-count">3 warianty</span>
                  </div>
                  <p class="hero-slide-name">Bambu Lab A1 Combo</p>
                  <ul class="product-badges">
                    <li>256×256×256 mm</li>
                    <li>AMS</li>
                    <li>WiFi</li>
                    <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
                  </ul>
                  <div class="mega-buy">
                    <p class="mega-price"><span class="mega-amount"><small>od</small> 1&nbsp;160<sup>00</sup> <span class="mega-currency">zł</span></span> <span class="mega-save">-150&nbsp;zł</span></p>
                    <div class="card-actions">
                      <a class="mini-link card-details" href="#drukarki">Szczegóły</a>
                      <a class="mega-cart mega-cart-variant" href="#drukarki">
                        <span class="icon icon-layers" aria-hidden="true"></span> Wybierz wariant
                      </a>
                    </div>
                    <p class="mega-low">Najniższa cena: 1&nbsp;310,00&nbsp;zł</p>
                  </div>
                </article>
                <article class="hero-slide">
                  <div class="product-shot">
                    <img src="assets/drukarka-3d-bambu-lab-a1-combo.webp" alt="Drukarka 3D Bambu Lab A1">
                    <span class="variant-count">2 warianty</span>
                  </div>
                  <p class="hero-slide-name">Bambu Lab A1</p>
                  <ul class="product-badges">
                    <li>256×256×256 mm</li>
                    <li>AMS</li>
                    <li>WiFi</li>
                    <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
                  </ul>
                  <div class="mega-buy">
                    <p class="mega-price"><span class="mega-amount"><small>od</small> 1&nbsp;160<sup>00</sup> <span class="mega-currency">zł</span></span></p>
                    <div class="card-actions">
                      <a class="mini-link card-details" href="#drukarki">Szczegóły</a>
                      <a class="mega-cart mega-cart-variant" href="#drukarki">
                        <span class="icon icon-layers" aria-hidden="true"></span> Wybierz wariant
                      </a>
                    </div>
                  </div>
                </article>
                <article class="hero-slide">
                  <div class="product-shot">
                    <img src="assets/drukarka-3d-bambu-lab-a1-combo.webp" alt="Drukarka 3D Bambu Lab A1 mini">
                    <span class="variant-count">4 warianty</span>
                  </div>
                  <p class="hero-slide-name">Bambu Lab A1 mini</p>
                  <ul class="product-badges">
                    <li>180×180×180 mm</li>
                    <li>AMS</li>
                    <li>WiFi</li>
                    <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
                  </ul>
                  <div class="mega-buy">
                    <p class="mega-price"><span class="mega-amount"><small>od</small> 845<sup>00</sup> <span class="mega-currency">zł</span></span></p>
                    <div class="card-actions">
                      <a class="mini-link card-details" href="#drukarki">Szczegóły</a>
                      <a class="mega-cart mega-cart-variant" href="#drukarki">
                        <span class="icon icon-layers" aria-hidden="true"></span> Wybierz wariant
                      </a>
                    </div>
                  </div>
                </article>
                <article class="hero-slide">
                  <div class="product-shot">
                    <img src="assets/drukarka-3d-bambu-lab-a1-combo.webp" alt="Drukarka 3D Bambu Lab X2D Combo">
                  </div>
                  <p class="hero-slide-name">Bambu Lab X2D Combo</p>
                  <ul class="product-badges">
                    <li>256×256×260 mm</li>
                    <li>AMS</li>
                    <li>WiFi</li>
                    <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
                  </ul>
                  <div class="mega-buy">
                    <p class="mega-price"><span class="mega-amount">3&nbsp;379<sup>00</sup> <span class="mega-currency">zł</span></span> <span class="mega-save">-400&nbsp;zł</span></p>
                    <div class="card-actions">
                      <a class="mini-link card-details" href="#drukarki">Szczegóły</a>
                      <button class="mega-cart" type="button" data-add data-id="x2d-combo" data-name="Bambu Lab X2D Combo" data-price="3379">
                        <span class="icon icon-cart" aria-hidden="true"></span> Kup teraz
                      </button>
                    </div>
                    <p class="mega-low">Najniższa cena: 3&nbsp;779,00&nbsp;zł</p>
                  </div>
                </article>
                <article class="hero-slide">
                  <div class="product-shot">
                    <img src="assets/bambu-lab-ams-2-pro.webp" alt="Bambu Lab AMS 2 Pro">
                  </div>
                  <p class="hero-slide-name">Bambu Lab AMS 2 Pro – Automatic Material System</p>
                  <ul class="product-badges">
                    <li>372×280×226 mm</li>
                    <li>Suszenie 65°C</li>
                    <li>RFID</li>
                    <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
                  </ul>
                  <div class="mega-buy">
                    <p class="mega-price"><span class="mega-amount">990<sup>00</sup> <span class="mega-currency">zł</span></span> <span class="mega-save">-300&nbsp;zł</span></p>
                    <div class="card-actions">
                      <a class="mini-link card-details" href="https://get3d.pl/drukarki-3d/bambu-lab-ams-2-pro/">Szczegóły</a>
                      <button class="mega-cart" type="button" data-add data-id="ams-2-pro" data-name="Bambu Lab AMS 2 Pro" data-price="990">
                        <span class="icon icon-cart" aria-hidden="true"></span> Kup teraz
                      </button>
                    </div>
                    <p class="mega-low">Najniższa cena: 1&nbsp;110,00&nbsp;zł</p>
                  </div>
                </article>
              </div>
            </div>
            <div class="hero-slider-bar">
              <button class="hero-slider-arrow" type="button" data-hero-dir="-1" aria-label="Poprzedni produkt">
                <span class="icon icon-back" aria-hidden="true"></span>
              </button>
              <div class="hero-slider-dots">
                <button type="button" class="is-on" data-hero-go="0" aria-label="Bambu Lab A1 Combo"></button>
                <button type="button" data-hero-go="1" aria-label="Bambu Lab A1"></button>
                <button type="button" data-hero-go="2" aria-label="Bambu Lab A1 mini"></button>
                <button type="button" data-hero-go="3" aria-label="Bambu Lab X2D Combo"></button>
                <button type="button" data-hero-go="4" aria-label="Bambu Lab AMS 2 Pro – Automatic Material System"></button>
              </div>
              <button class="hero-slider-arrow" type="button" data-hero-dir="1" aria-label="Następny produkt">
                <span class="icon icon-arrow" aria-hidden="true"></span>
              </button>
            </div>
          </div>
        </div>
      </div>
</section>
