---
const rowClass =
  "mt-7 grid list-none grid-cols-7 gap-x-4 gap-y-[22px] p-0 max-[980px]:-mr-3 max-[980px]:flex max-[980px]:snap-x max-[980px]:snap-mandatory max-[980px]:gap-3.5 max-[980px]:overflow-x-auto max-[980px]:pb-2";

const itemClass = "max-[980px]:w-[132px] max-[980px]:shrink-0 max-[980px]:snap-start";

const linkClass = "group flex flex-col items-center gap-3 text-center text-ink";

const shotClass = "block w-full overflow-hidden rounded-[22px] bg-stone-50";

const imgClass =
  "aspect-square w-full bg-stone-50 object-contain transition-transform duration-[650ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105";

const nameClass =
  "inline-flex items-center gap-1.5 font-heading text-[17px] font-semibold leading-none text-stone-700 group-hover:text-ink min-[1501px]:text-lg after:size-[11px] after:shrink-0 after:bg-stone-400 after:content-[''] after:[-webkit-mask:url('/assets/icons/arrow-right-down.svg')_center/contain_no-repeat] after:[mask:url('/assets/icons/arrow-right-down.svg')_center/contain_no-repeat]";

const categories = [
  { href: "#drukarki", img: "assets/images/get3d-drukarki3d.webp", name: "Drukarki 3D" },
  { href: "#kontakt", img: "assets/images/get3d-formierki3d.webp", name: "Formierki 3D" },
  { href: "#materialy", img: "assets/images/get3d-filamenty.webp", name: "Filamenty" },
  { href: "#materialy", img: "assets/images/get3d-zywice.webp", name: "Żywice" },
  { href: "#akcesoria", img: "assets/images/get3d-akcesoria.webp", name: "Akcesoria" },
  { href: "#serwis", img: "assets/images/get3d-szkolenia.webp", name: "Szkolenia" },
  { href: "#serwis", img: "assets/images/get3d-serwis.webp", name: "Serwis" },
];
---

<section class="pt-9 pb-7" aria-labelledby="cat-picks-title">
  <div class="mx-auto w-full max-w-[1500px] px-[30px]">
    <div class="flex items-center justify-between gap-4">
      <h2 id="cat-picks-title" class="text-[clamp(26px,2.4vw,32px)]">Oferta sklepu get3D</h2>
      <a class="mini-link" href="#drukarki">Wszystkie</a>
    </div>
    <ul class={rowClass}>
      {
        categories.map((cat) => (
          <li class={itemClass}>
            <a class={linkClass} href={cat.href}>
              <span class={shotClass}>
                <img class={imgClass} src={cat.img} alt="" />
              </span>
              <span class={nameClass}>{cat.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>