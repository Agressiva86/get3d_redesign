---
<header class="nav" id="start">
    <ul class="info-bar">
      <li><span class="icon icon-house" aria-hidden="true"></span>Darmowa dostawa do showroomu od 250 zł</li>
      <li><span class="icon icon-card" aria-hidden="true"></span>Zniżka z Kartą Łodzianina</li>
      <li><span class="icon icon-flag" aria-hidden="true"></span>Polski sklep od <span data-since="2015">11 lat</span> na rynku</li>
    </ul>
    <div class="nav-top">
      <a class="logo" href="#start" aria-label="get3D, strona główna">
        <img src="assets/get3d%20logo.svg" alt="get3D">
      </a>
      <button class="burger" type="button" aria-label="Kategorie" aria-expanded="false" aria-controls="nav-cats"><span></span><em class="burger-label">Kategorie</em></button>
      <form class="nav-search" role="search">
        <label class="sr" for="search-input">Czego szukasz?</label>
        <input id="search-input" type="search" placeholder="Czego szukasz?" autocomplete="off" aria-autocomplete="list" aria-controls="search-pop" aria-expanded="false">
        <button type="submit" aria-label="Szukaj"><span class="icon icon-search" aria-hidden="true"></span></button>
        <div class="search-pop" id="search-pop" hidden></div>
      </form>
      <div class="nav-tools">
        <div class="tool" id="account-tool">
          <button class="tool-btn" type="button" id="account-open" aria-expanded="false" aria-label="Konto">
            <span class="icon icon-user" aria-hidden="true"></span>
            <span class="tool-label">Konto</span>
          </button>
          <div class="account-pop" id="account-pop">
            <div class="sheet-bar">
              <p class="sheet-title">Konto</p>
              <button class="sheet-x" type="button" data-close-sheet aria-label="Zamknij"><span></span></button>
            </div>
            <div id="account-guest">
              <button class="account-login" type="button" id="show-login">Zaloguj się</button>
              <p class="account-or"><span>Nie masz konta?</span></p>
              <button class="account-register" type="button" id="show-register">Załóż konto</button>
            </div>
            <form id="login-form" hidden>
              <input type="email" name="email" required placeholder="E-mail*" aria-label="E-mail">
              <input type="password" name="password" required placeholder="Hasło*" aria-label="Hasło" minlength="4">
              <button class="account-login" type="submit">Zaloguj się</button>
              <button class="account-back" type="button" id="login-back">Wróć</button>
              <p class="form-note" id="login-note"></p>
            </form>
            <nav class="account-menu" aria-label="Konto">
              <button type="button" id="account-home"><span class="icon icon-user" aria-hidden="true"></span>Twoje konto</button>
              <a href="#cennik"><span class="icon icon-receipt" aria-hidden="true"></span>Zamówienia</a>
              <a href="#pytania"><span class="icon icon-refresh" aria-hidden="true"></span>Zwroty i reklamacje</a>
              <a href="#serwis"><span class="icon icon-box" aria-hidden="true"></span>Serwis</a>
              <a href="#opinie"><span class="icon icon-comment" aria-hidden="true"></span>Opinie</a>
              <a href="#kontakt"><span class="icon icon-pin" aria-hidden="true"></span>Dane do zamówień</a>
              <button type="button" id="logout" hidden><span class="icon icon-out" aria-hidden="true"></span>Wyloguj</button>
            </nav>
            <button class="account-tone" type="button" id="account-tone" aria-pressed="false">
              <span class="icon icon-mode" aria-hidden="true"></span>
              <span>Jaśniejsze tło<small id="tone-state">Wyłączone</small></span>
            </button>
          </div>
        </div>
        <div class="tool drop">
          <button class="tool-btn drop-btn" type="button" aria-expanded="false" aria-label="Pomoc">
            <span class="icon icon-headphones" aria-hidden="true"></span>
            <span class="tool-label">Pomoc</span>
          </button>
          <div class="drop-panel help-pop">
            <div class="sheet-bar">
              <p class="sheet-title">Pomoc</p>
              <button class="sheet-x" type="button" data-close-sheet aria-label="Zamknij"><span></span></button>
            </div>
            <p class="help-kicker">Popularne tematy</p>
            <nav class="help-topics" aria-label="Popularne tematy">
              <a href="#pytania">Dostawa</a>
              <a href="#cennik">Raty</a>
              <a href="#cennik">Leasing</a>
              <a href="#kontakt">Zakupy dla firm</a>
              <a href="#pytania">Zwroty</a>
              <a href="#serwis">Reklamacje</a>
              <a href="#serwis">Serwis</a>
              <a href="#pytania">Najczęściej zadawane pytania</a>
            </nav>
            <p class="help-kicker">Skontaktuj się z nami</p>
            <div class="help-contact">
              <a href="#kontakt"><span class="icon icon-headphones" aria-hidden="true"></span>Kontakt</a>
              <a href="#kontakt"><span class="icon icon-house" aria-hidden="true"></span><span>Showroom<small>Wróblewskiego 70/72, 93-566 Łódź</small></span></a>
              <a href="mailto:biuro@get3d.pl"><span class="icon icon-mail" aria-hidden="true"></span>biuro@get3d.pl</a>
              <a href="tel:+48426305050"><span class="icon icon-phone" aria-hidden="true"></span>42 630 50 50</a>
            </div>
            <div class="help-social">
              <a href="https://www.facebook.com/get3dpl" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><span class="icon icon-facebook" aria-hidden="true"></span></a>
              <a href="https://x.com/get3dpl" target="_blank" rel="noopener noreferrer" aria-label="X"><span class="icon icon-x" aria-hidden="true"></span></a>
              <a href="https://www.youtube.com/@get3dlab" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><span class="icon icon-youtube" aria-hidden="true"></span></a>
              <a href="https://www.linkedin.com/company/18726552/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><span class="icon icon-linkedin" aria-hidden="true"></span></a>
            </div>
          </div>
        </div>
        <div class="tool" id="cart-tool">
          <button class="tool-btn cart-btn" type="button" id="cart-open" aria-expanded="false" aria-label="Koszyk">
            <span class="ico">
              <span class="icon icon-cart" aria-hidden="true"></span>
              <span class="cart-count" data-count="0">0</span>
            </span>
            <span class="tool-label">Koszyk</span>
          </button>
          <div class="cart-pop" id="cart-pop">
            <div class="sheet-bar">
              <p class="sheet-title">Koszyk</p>
              <button class="sheet-x" type="button" data-close-sheet aria-label="Zamknij"><span></span></button>
            </div>
            <div class="cart-empty" id="cart-empty">
              <p class="cart-empty-title">Koszyk jest pusty</p>
              <p class="cart-empty-copy"><button type="button" id="cart-login">Zaloguj się</button>, aby sprawdzić zapisane produkty lub zainspiruj się</p>
              <a class="cart-outline" href="#cennik">Przejdź do promocji</a>
            </div>
            <div class="cart-filled" id="cart-filled" hidden>
              <div class="cart-mini" id="cart-mini"></div>
              <button class="cart-outline" type="button" id="cart-go">Przejdź do koszyka</button>
            </div>
          </div>
        </div>
        <button class="tool-btn tone-btn" type="button" aria-label="Jaśniejsze tło" aria-pressed="false">
          <span class="icon icon-mode" aria-hidden="true"></span>
        </button>
      </div>
