---
/** Powłoka nagłówka — bez utilities (stany .is-compact / .is-open w header-interactions + responsive). */
const navClass = "nav";
const infoBarClass = "info-bar";
const navTopClass = "nav-top";
const logoClass = "logo";
const burgerClass = "burger";
const burgerLabelClass = "burger-label";
const navSearchClass = "nav-search";
const searchPopClass = "search-pop";
const navToolsClass = "nav-tools";
const toolClass = "tool";
const toolBtnClass = "tool-btn";

const toolLabelClass = "tool-label";

const accountPopClass = "account-pop";

const sheetBarClass = "sheet-bar";
const sheetTitleClass = "sheet-title";
const sheetXClass = "sheet-x";

const accountLoginClass =
  "account-login min-h-12 w-full border-0 bg-stone-900 text-white hover:bg-stone-800";
const accountRegisterClass =
  "account-register min-h-12 w-full border-0 bg-stone-100 text-ink hover:bg-stone-200";
const accountOrClass =
  "account-or my-3 mt-3 flex items-center gap-3 text-sm text-stone-500 before:h-px before:flex-1 before:bg-stone-200 after:h-px after:flex-1 after:bg-stone-200";
const accountBackClass =
  "account-back border-0 bg-transparent p-0 pt-0.5 text-sm text-stone-500";
const accountMenuClass =
  "account-menu -mx-1 mt-3 grid border-t border-stone-200 pt-2 [&_a]:flex [&_button]:flex [&_a]:w-full [&_button]:w-full [&_a]:items-center [&_button]:items-center [&_a]:gap-3.5 [&_button]:gap-3.5 [&_a]:rounded-[var(--radius)] [&_button]:rounded-[var(--radius)] [&_a]:border-0 [&_button]:border-0 [&_a]:bg-transparent [&_button]:bg-transparent [&_a]:px-3 [&_button]:px-3 [&_a]:py-[7px] [&_button]:py-[7px] [&_a]:text-left [&_button]:text-left [&_a]:font-display [&_button]:font-display [&_a]:text-[15px] [&_button]:text-[15px] [&_a]:font-normal [&_button]:font-normal [&_a]:text-stone-800 [&_button]:text-stone-800 [&_a:hover]:bg-stone-100 [&_button:hover]:bg-stone-100 [&_.icon]:size-[22px]";
const accountToneClass =
  "account-tone -mx-1 mt-1.5 flex w-full items-center gap-3.5 rounded-[var(--radius)] border-0 border-t border-stone-200 bg-transparent px-3 pb-0 pt-3 text-left font-display text-[15px] font-normal text-stone-800 hover:bg-stone-100 [&_.icon]:size-[22px] [&_small]:mt-px [&_small]:block [&_small]:font-sans [&_small]:text-[13px] [&_small]:font-light [&_small]:text-stone-500";

const dropBtnToolsClass = "tool-btn drop-btn";
const helpPopClass = "drop-panel help-pop";
const helpKickerClass =
  "help-kicker mx-2 mb-0.5 font-display text-xs font-normal tracking-[0.06em] text-stone-600 uppercase";
const helpTopicsClass = "help-topics grid";
const helpTopicsLinkClass =
  "rounded-[var(--radius)] px-2 py-1.5 font-display text-[15px] font-normal text-stone-800 hover:bg-stone-100";
const helpContactClass = "help-contact grid";
const helpContactLinkClass =
  "flex items-center gap-3.5 rounded-[var(--radius)] px-2 py-[7px] font-display text-[15px] font-normal text-stone-800 hover:bg-stone-100 [&_.icon]:size-[22px] [&_small]:mt-px [&_small]:block [&_small]:font-sans [&_small]:text-[13px] [&_small]:font-light [&_small]:text-stone-500";
const helpSocialClass =
  "help-social mt-2 flex gap-1 border-t border-stone-200 pt-2.5";
const helpSocialLinkClass =
  "grid size-10 place-items-center rounded-[var(--radius)] text-stone-800 hover:bg-stone-100 [&_.icon]:size-[22px]";

const cartBtnClass = "tool-btn cart-btn relative";
const icoClass = "ico relative grid place-items-center";
const cartCountClass = "cart-count";
const cartPopClass = "cart-pop";
const cartEmptyTitleClass =
  "cart-empty-title my-1 mb-3 font-display text-[22px] font-normal leading-[1.25] text-ink";
const cartEmptyCopyClass = "cart-empty-copy m-0 mb-[22px] text-[15px] leading-[1.45] text-stone-700";
const cartOutlineClass =
  "cart-outline min-h-12 w-full border border-stone-300 bg-white text-ink";
const cartMiniClass = "cart-mini mb-3.5 grid gap-0.5 text-left";
const toneBtnClass = "tool-btn tone-btn";

const navShadeClass = "nav-shade";
const catBarClass = "cat-bar";
const navCatsClass = "nav-cats";

const drawerBarClass = "drawer-bar";
const drawerBackClass = "drawer-back";
const drawerTitleClass = "drawer-title";
const drawerCloseClass = "drawer-close";
const drawerBodyClass = "drawer-body";
const drawerKickerClass = "drawer-kicker";

const catDropClass = "drop";
const catDropBtnClass = "drop-btn";
const chevClass = "chev icon icon-arrow-corner";
const catDropPanelClass = "drop-panel";
const dropFormierkiClass = "drop-panel drop-formierki";
const drawerAllClass = "drawer-all";

/** Bez utilities — wysokość mega-menu (w tym tryb .is-compact + JS) steruje header-interactions.css */
const megaClass = "mega";
const megaSideClass = "mega-side";
const megaAllClass =
  "mega-all flex min-h-11 items-center justify-between gap-3 rounded-[var(--radius)] py-0 pr-3 pl-3.5 font-display text-[15px] font-normal text-stone-500 min-[981px]:min-h-9 min-[981px]:px-2.5 min-[981px]:text-sm max-[980px]:hidden";
const megaBranchClass = "mega-branch";
const megaNameClass =
  "mega-name flex min-h-11 items-center justify-between gap-3 rounded-[var(--radius)] py-0 pr-3 pl-3.5 font-heading text-[15px] font-semibold text-ink min-[981px]:min-h-9 min-[981px]:px-2.5 min-[981px]:text-sm max-[980px]:rounded-none max-[980px]:px-4 max-[980px]:font-semibold";
const megaKidsClass = "mega-kids";
const megaKickerClass =
  "mega-kicker mx-3 mt-1 mb-2.5 font-heading text-lg font-semibold leading-tight text-ink max-[980px]:hidden";
const megaNewClass =
  "mega-new ml-2 inline-flex items-center justify-center border border-accent px-[5px] pt-0.5 pb-0 text-[9px] font-semibold leading-none tracking-[0.04em] text-accent uppercase";
const megaFeatureClass = "mega-feature hero-slide";
const megaBuyClass = "mega-buy mt-3.5 grid grid-cols-1 items-stretch gap-x-2 gap-y-1";
const megaPriceClass =
  "mega-price m-0 flex flex-wrap items-baseline gap-x-2 gap-y-1 font-heading text-[26px] font-semibold leading-none text-[#25a244]";
const megaAmountClass = "mega-amount whitespace-nowrap [&_small]:mr-px [&_small]:text-[13px] [&_small]:font-medium [&_sup]:-top-[0.7em] [&_sup]:text-xs [&_sup]:font-semibold";
const megaCurrencyClass = "mega-currency text-sm font-medium";
const megaSaveClass =
  "mega-save self-center rounded-[var(--radius)] bg-[rgba(37,162,68,0.12)] px-1.5 py-0.5 text-xs font-semibold leading-4 text-[#25a244]";
const megaLowClass =
  "mega-low col-span-full m-0 font-sans text-xs font-normal leading-[1.3] text-stone-500";
const megaCartVariantClass = "mega-cart mega-cart-variant";

const navLinkClass = "nav-link";
const bfCtaClass = "bf-cta";
---
<header class={navClass} id="start">
    <ul class={infoBarClass}>
      <li><span class="icon icon-house" aria-hidden="true"></span>Darmowa dostawa do showroomu od 250 zł</li>
      <li><span class="icon icon-card" aria-hidden="true"></span>Zniżka z Kartą Łodzianina</li>
      <li><span class="icon icon-flag" aria-hidden="true"></span>Polski sklep od <span data-since="2015">11 lat</span> na rynku</li>
    </ul>
    <div class={navTopClass}>
      <a class={logoClass} href="#start" aria-label="get3D, strona główna">
        <img src="assets/get3d%20logo.svg" alt="get3D">
      </a>
      <button class={burgerClass} type="button" aria-label="Kategorie" aria-expanded="false" aria-controls="nav-cats"><span></span><em class={burgerLabelClass}>Kategorie</em></button>
      <form class={navSearchClass} role="search">
        <label class="sr" for="search-input">Czego szukasz?</label>
        <input id="search-input" type="search" placeholder="Czego szukasz?" autocomplete="off" aria-autocomplete="list" aria-controls="search-pop" aria-expanded="false">
        <button type="submit" aria-label="Szukaj"><span class="icon icon-search" aria-hidden="true"></span></button>
        <div class={searchPopClass} id="search-pop" hidden></div>
      </form>
      <div class={navToolsClass}>
        <div class={toolClass} id="account-tool">
          <button class={toolBtnClass} type="button" id="account-open" aria-expanded="false" aria-label="Konto">
            <span class="icon icon-user" aria-hidden="true"></span>
            <span class={toolLabelClass}>Konto</span>
          </button>
          <div class={accountPopClass} id="account-pop">
            <div class={sheetBarClass}>
              <p class={sheetTitleClass}>Konto</p>
              <button class={sheetXClass} type="button" data-close-sheet aria-label="Zamknij"><span></span></button>
            </div>
            <div id="account-guest">
              <button class={accountLoginClass} type="button" id="show-login">Zaloguj się</button>
              <p class={accountOrClass}><span>Nie masz konta?</span></p>
              <button class={accountRegisterClass} type="button" id="show-register">Załóż konto</button>
            </div>
            <form id="login-form" hidden>
              <input type="email" name="email" required placeholder="E-mail*" aria-label="E-mail">
              <input type="password" name="password" required placeholder="Hasło*" aria-label="Hasło" minlength="4">
              <button class={accountLoginClass} type="submit">Zaloguj się</button>
              <button class={accountBackClass} type="button" id="login-back">Wróć</button>
              <p class="form-note" id="login-note"></p>
            </form>
            <nav class={accountMenuClass} aria-label="Konto">
              <button type="button" id="account-home"><span class="icon icon-user" aria-hidden="true"></span>Twoje konto</button>
              <a href="#cennik"><span class="icon icon-receipt" aria-hidden="true"></span>Zamówienia</a>
              <a href="#pytania"><span class="icon icon-refresh" aria-hidden="true"></span>Zwroty i reklamacje</a>
              <a href="#serwis"><span class="icon icon-box" aria-hidden="true"></span>Serwis</a>
              <a href="#opinie"><span class="icon icon-comment" aria-hidden="true"></span>Opinie</a>
              <a href="#kontakt"><span class="icon icon-pin" aria-hidden="true"></span>Dane do zamówień</a>
              <button type="button" id="logout" hidden><span class="icon icon-out" aria-hidden="true"></span>Wyloguj</button>
            </nav>
            <button class={accountToneClass} type="button" id="account-tone" aria-pressed="false">
              <span class="icon icon-mode" aria-hidden="true"></span>
              <span>Jaśniejsze tło<small id="tone-state">Wyłączone</small></span>
            </button>
          </div>
        </div>
        <div class={`${toolClass} drop`}>
          <button class={dropBtnToolsClass} type="button" aria-expanded="false" aria-label="Pomoc">
            <span class="icon icon-headphones" aria-hidden="true"></span>
            <span class={toolLabelClass}>Pomoc</span>
          </button>
          <div class={helpPopClass}>
            <div class={sheetBarClass}>
              <p class={sheetTitleClass}>Pomoc</p>
              <button class={sheetXClass} type="button" data-close-sheet aria-label="Zamknij"><span></span></button>
            </div>
            <p class={helpKickerClass}>Popularne tematy</p>
            <nav class={helpTopicsClass} aria-label="Popularne tematy">
              <a class={helpTopicsLinkClass} href="#pytania">Dostawa</a>
              <a class={helpTopicsLinkClass} href="#cennik">Raty</a>
              <a class={helpTopicsLinkClass} href="#cennik">Leasing</a>
              <a class={helpTopicsLinkClass} href="#kontakt">Zakupy dla firm</a>
              <a class={helpTopicsLinkClass} href="#pytania">Zwroty</a>
              <a class={helpTopicsLinkClass} href="#serwis">Reklamacje</a>
              <a class={helpTopicsLinkClass} href="#serwis">Serwis</a>
              <a class={helpTopicsLinkClass} href="#pytania">Najczęściej zadawane pytania</a>
            </nav>
            <p class={helpKickerClass}>Skontaktuj się z nami</p>
            <div class={helpContactClass}>
              <a class={helpContactLinkClass} href="#kontakt"><span class="icon icon-headphones" aria-hidden="true"></span>Kontakt</a>
              <a class={helpContactLinkClass} href="#kontakt"><span class="icon icon-house" aria-hidden="true"></span><span>Showroom<small>Wróblewskiego 70/72, 93-566 Łódź</small></span></a>
              <a class={helpContactLinkClass} href="mailto:biuro@get3d.pl"><span class="icon icon-mail" aria-hidden="true"></span>biuro@get3d.pl</a>
              <a class={helpContactLinkClass} href="tel:+48426305050"><span class="icon icon-phone" aria-hidden="true"></span>42 630 50 50</a>
            </div>
            <div class={helpSocialClass}>
              <a class={helpSocialLinkClass} href="https://www.facebook.com/get3dpl" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><span class="icon icon-facebook" aria-hidden="true"></span></a>
              <a class={helpSocialLinkClass} href="https://x.com/get3dpl" target="_blank" rel="noopener noreferrer" aria-label="X"><span class="icon icon-x" aria-hidden="true"></span></a>
              <a class={helpSocialLinkClass} href="https://www.youtube.com/@get3dlab" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><span class="icon icon-youtube" aria-hidden="true"></span></a>
              <a class={helpSocialLinkClass} href="https://www.linkedin.com/company/18726552/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><span class="icon icon-linkedin" aria-hidden="true"></span></a>
            </div>
          </div>
        </div>
        <div class={toolClass} id="cart-tool">
          <button class={cartBtnClass} type="button" id="cart-open" aria-expanded="false" aria-label="Koszyk">
            <span class={icoClass}>
              <span class="icon icon-cart" aria-hidden="true"></span>
              <span class={cartCountClass} data-count="0">0</span>
            </span>
            <span class={toolLabelClass}>Koszyk</span>
          </button>
          <div class={cartPopClass} id="cart-pop">
            <div class={sheetBarClass}>
              <p class={sheetTitleClass}>Koszyk</p>
              <button class={sheetXClass} type="button" data-close-sheet aria-label="Zamknij"><span></span></button>
            </div>
            <div class="cart-empty" id="cart-empty">
              <p class={cartEmptyTitleClass}>Koszyk jest pusty</p>
              <p class={cartEmptyCopyClass}><button type="button" id="cart-login">Zaloguj się</button>, aby sprawdzić zapisane produkty lub zainspiruj się</p>
              <a class={cartOutlineClass} href="#cennik">Przejdź do promocji</a>
            </div>
            <div class="cart-filled" id="cart-filled" hidden>
              <div class={cartMiniClass} id="cart-mini"></div>
              <button class={cartOutlineClass} type="button" id="cart-go">Przejdź do koszyka</button>
            </div>
          </div>
        </div>
        <button class={toneBtnClass} type="button" aria-label="Jaśniejsze tło" aria-pressed="false">
          <span class="icon icon-mode" aria-hidden="true"></span>
        </button>
      </div>
    </div>
    <button class={navShadeClass} type="button" aria-label="Zamknij menu"></button>
    <div class={catBarClass}>
    <nav class={navCatsClass} id="nav-cats" aria-label="Oferta">
      <div class={drawerBarClass}>
        <button class={drawerBackClass} type="button" aria-label="Wróć"><span class="icon icon-back" aria-hidden="true"></span></button>
        <p class={drawerTitleClass} id="drawer-title">Menu</p>
        <button class={drawerCloseClass} type="button" aria-label="Zamknij menu"><span></span></button>
      </div>
      <div class={drawerBodyClass}>
        <p class={drawerKickerClass}>Kategorie</p>
      <div class={catDropClass}>
        <button class={catDropBtnClass} type="button" aria-expanded="false">Drukarki 3D <span class={chevClass} aria-hidden="true"></span></button>
