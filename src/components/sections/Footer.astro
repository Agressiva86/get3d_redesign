      </svg>
    </div>

<script is:inline define:vars={{ newsFieldsInvalidClass }}>
  (() => {
    const form = document.getElementById("newsletter");
    if (!form) return;
    const fields = form.querySelector("[data-newsletter-fields]");
    const emailInput = form.querySelector('input[name="email"]');
    if (!fields || !emailInput) return;

    const setEmailError = (on) => {
      fields.classList.toggle(newsFieldsInvalidClass, on);
      emailInput.setAttribute("aria-invalid", on ? "true" : "false");
    };

    const emailIsValid = () => emailInput.checkValidity();

    emailInput.addEventListener("input", () => {
      if (emailIsValid()) setEmailError(false);
    });

    form.addEventListener(
      "submit",
      (event) => {
        const consent = form.querySelector('input[name="consent"]');
        const emailOk = emailIsValid();
        setEmailError(!emailOk);
        if (!emailOk) {
          event.preventDefault();
          event.stopImmediatePropagation();
          emailInput.focus();
          return;
        }
        if (!consent?.checked) {
          event.preventDefault();
          event.stopImmediatePropagation();
          consent?.focus();
        }
      },
      true,
    );
  })();
</script>
</footer>