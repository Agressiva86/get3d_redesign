---
const sectionClass =
  "mx-5 mt-2 mb-8 w-[calc(100%-40px)] rounded-[22px] bg-stone-50 px-[max(10px,calc((100%-1500px)/2-20px))] py-11 pb-[52px] max-[980px]:mx-[30px] max-[980px]:mt-1.5 max-[980px]:mb-6 max-[980px]:w-[calc(100%-60px)] max-[980px]:p-[30px]";

const innerClass = "mx-auto w-full max-w-[1024px]";

const layoutClass =
  "grid grid-cols-[minmax(0,1.02fr)_minmax(240px,0.98fr)] items-start gap-x-14 gap-y-12 max-[980px]:grid-cols-1 max-[980px]:gap-9";

const titleClass =
  "max-w-[14em] text-[clamp(32px,3.4vw,46px)] font-semibold leading-[1.08] tracking-normal max-[980px]:max-w-none";

const listClass = "mt-7";

const itemClass =
  "border-t border-stone-200 py-[22px] first:border-t-0 first:pt-0 last:pb-0";

const itemTitleClass = "text-[clamp(18px,1.5vw,21px)] font-semibold leading-tight";

const itemTextClass =
  "mt-2 max-w-[46ch] text-[15px] font-light leading-[1.55] text-stone-600";

const mediaClass =
  "sticky top-[clamp(92px,11vh,132px)] w-full self-start max-[980px]:static";

const videoWrapClass =
  "relative m-0 aspect-[4/5] w-full overflow-hidden rounded-[22px] bg-stone-900 @container max-[980px]:aspect-video max-[980px]:max-h-[min(42vh,380px)]";

const videoClass = "absolute inset-0 block h-full w-full object-cover";

const captionClass =
  "hero-caption absolute inset-x-0 bottom-0 z-[1] flex flex-col items-start gap-2 pt-[92px] pr-[22px] pb-5 pl-[22px] before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:bg-gradient-to-t before:from-[rgba(21,0,41,0.55)] before:from-0% before:via-[rgba(21,0,41,0.32)] before:via-[55%] before:to-transparent before:to-100% before:backdrop-blur-[16px] before:backdrop-saturate-[1.4] before:[mask-image:linear-gradient(to_top,#000_0%,#000_52%,transparent_100%)] before:[-webkit-mask-image:linear-gradient(to_top,#000_0%,#000_52%,transparent_100%)]";

const captionTitleClass =
  "m-0 w-[calc(70cqw-22px)] max-w-full font-display text-[clamp(20px,5.5cqw,26px)] font-medium leading-[1.05] tracking-normal text-white max-[980px]:w-full";

const captionTextClass =
  "m-0 w-[calc(70cqw-22px)] max-w-full text-[13px] leading-[1.4] text-white max-[980px]:w-full";

const captionActionsClass =
  "hero-caption-actions mt-1.5 flex w-auto max-w-full flex-wrap gap-2 max-[980px]:w-full";

const phoneHref = "tel:+48426305050";

const items = [
  {
    title: "Pierwsza drukarka do domu",
    text: "Kompaktowe modele z szybkim startem, cichą pracą i gotowymi profilami — od pierwszej figurki po codzienne projekty na biurku.",
    href: "https://get3d.pl/drukarki-3d/bambu-lab/",
    link: "Drukarki do domu",
  },
  {
    title: "Drukarka dla firmy",
    text: "Maszyny do prototypów i krótkich serii: większe pole robocze, stabilna praca i wsparcie wdrożeniowe, gdy druk ma iść obok produkcji.",
    href: "https://get3d.pl/drukarki-3d/raise-3d/",
    link: "Drukarki dla firm",
  },
  {
    title: "Stomatologia i medycyna",
    text: "Drukarki żywiczne, materiały biokompatybilne i workflow pod modele, szyny i elementy protetyczne — z doradztwem przy doborze żywic.",
    href: "https://get3d.pl/drukarki-3d/formlabs/",
    link: "Drukarki dla stomatologii",
  },
  {
    title: "Materiały techniczne",
    text: "Urządzenia pod PA, PC, włókna i kompozyty — gdy liczy się temperatura komory, zamknięta obudowa i powtarzalność wydruku.",
    href: "https://get3d.pl/drukarki-3d/minifactory/",
    link: "Drukarki pod materiały techniczne",
  },
  {
    title: "Druk z metalu",
    text: "Systemy metalowe do narzędzi, wkładów i elementów funkcjonalnych — od warsztatu badawczego po przygotowanie produkcji seryjnej.",
    href: "https://get3d.pl/drukarki-3d/desktop-metal/",
    link: "Drukarki metalem",
  },
  {
    title: "Edukacja",
    text: "Bezpieczne zestawy dla szkół i pracowni: prosta obsługa, szkolenia operatorów i serwis, który nie wyciąga zajęć z rytmu.",
    href: "https://get3d.pl/drukarki-3d/prusa/",
    link: "Drukarki do edukacji",
  },
];
---

<section class={sectionClass} id="wybor-drukarki" aria-labelledby="print-guide-title">
  <div class={innerClass}>
    <div class={layoutClass}>
      <div>
        <h2 id="print-guide-title" class={titleClass}>Pomożemy Ci wybrać odpowiednią drukarkę 3D</h2>
        <div class={listClass}>
          {
            items.map((item) => (
              <article class={itemClass}>
                <h3 class={itemTitleClass}>{item.title}</h3>
                <p class={itemTextClass}>{item.text}</p>
                <a class="mini-link mt-3.5" href={item.href}>
                  {item.link}
                </a>
              </article>
            ))
          }
        </div>
      </div>
      <div class={mediaClass}>
        <figure class={videoWrapClass}>
          <video
            class={videoClass}
            src="assets/video/print-guide.mp4"
            width="1920"
            height="1080"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
          ></video>
          <div class={captionClass}>
            <h3 class={captionTitleClass}>Wciąż nie wiesz jakie urządzenie wybrać?</h3>
            <p class={captionTextClass}>
              Doradzimy przy wyborze drukarki, materiałów i konfiguracji — od pierwszych pytań po wdrożenie u
              Ciebie w pracowni lub firmie.
            </p>
            <div class={captionActionsClass}>
              <a class="hero-caption-btn hero-caption-btn-solid" href={phoneHref}>
                <span class="btn-label">Skorzystaj z pomocy, zadzwoń</span>
                <span class="btn-chip"><span class="icon icon-phone" aria-hidden="true"></span></span>
              </a>
            </div>
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>