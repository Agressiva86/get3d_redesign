---
const sectionClass = "py-2 pb-12";

const layoutClass =
  "mx-auto grid w-full max-w-[1500px] grid-cols-[minmax(280px,0.86fr)_minmax(0,1.14fr)] items-stretch gap-[18px] px-[30px] max-[980px]:grid-cols-1";

const photoClass =
  "@container relative m-0 min-h-full overflow-hidden rounded-[22px] bg-stone-200 max-[980px]:min-h-0 max-[980px]:aspect-[4/5]";

const photoImgClass =
  "absolute inset-0 h-full w-full max-w-none object-cover object-[82%_center]";

const markClass =
  "hero-mark pointer-events-none absolute top-[18px] right-[18px] z-[2] h-[21px] w-7 fill-white [&_path:nth-child(1)]:opacity-50 [&_path:nth-child(2)]:opacity-30 [&_path:nth-child(3)]:opacity-10";

const captionClass =
  "hero-caption absolute inset-x-0 bottom-0 z-[1] flex flex-col items-start gap-2 pt-[92px] pr-[22px] pb-5 pl-[22px] before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:bg-gradient-to-t before:from-[rgba(21,0,41,0.55)] before:from-0% before:via-[rgba(21,0,41,0.32)] before:via-[55%] before:to-transparent before:to-100% before:backdrop-blur-[16px] before:backdrop-saturate-[1.4] before:[mask-image:linear-gradient(to_top,#000_0%,#000_52%,transparent_100%)] before:[-webkit-mask-image:linear-gradient(to_top,#000_0%,#000_52%,transparent_100%)]";

const wordmarkClass = "brand-wordmark mb-3.5 block h-auto w-[148px]";

const captionTitleClass =
  "m-0 w-[calc(70cqw-22px)] max-w-full font-display text-[26px] font-medium leading-[1.05] text-white max-[980px]:w-full";

const captionTextClass =
  "m-0 w-[calc(70cqw-22px)] max-w-full text-[13px] leading-[1.4] text-white max-[980px]:w-full";

const captionActionsClass =
  "hero-caption-actions mt-1.5 flex w-auto max-w-full flex-wrap gap-2 max-[980px]:w-full";

const captionBtnBase =
  "hero-caption-btn inline-flex min-h-10 items-center gap-2 rounded-full border border-white/45 bg-transparent px-4 font-[Familjen_Grotesk,Geist,Arial,sans-serif] text-sm font-medium leading-none tracking-normal whitespace-nowrap text-white no-underline transition-[background-color,border-color,box-shadow] duration-200 ease-out after:h-4 after:w-4 after:shrink-0 after:bg-current after:content-[''] after:[-webkit-mask:url('/get3d_redesign/assets/icons/arrow-right-down.svg')_center/contain_no-repeat] after:[mask:url('/get3d_redesign/assets/icons/arrow-right-down.svg')_center/contain_no-repeat] hover:border-transparent hover:bg-stone-900 hover:text-white hover:shadow-[0_8px_18px_rgba(21,0,41,0.38)] focus-visible:border-transparent focus-visible:bg-stone-900 focus-visible:text-white focus-visible:shadow-[0_8px_18px_rgba(21,0,41,0.38)]";

const panelClass = "flex min-w-0 flex-col rounded-[22px] bg-stone-100 p-[18px]";

const pairSliderClass = "pair-slider mt-0 min-w-0";

const viewportClass =
  "pair-slider-viewport min-w-0 cursor-grab overflow-hidden touch-pan-y [&.is-grabbing]:cursor-grabbing [&.is-grabbing_.hero-slide]:cursor-grabbing [&.is-grabbing_.hero-slide]:select-none";

const trackClass =
  "pair-slider-track flex w-full gap-3.5 transition-transform duration-[550ms] ease-[cubic-bezier(0.22,1,0.36,1)]";

const slideClass =
  "hero-slide relative flex min-w-0 flex-[0_0_calc((100%-14px)/2)] flex-col w-[calc((100%-14px)/2)] rounded-[22px] bg-white p-4 max-[760px]:w-full max-[760px]:flex-[0_0_100%]";
---
