                <path d="M225.24,87.41h43.8l0.01-29.74c0-6.26-5.08-11.3-11.34-11.3h-40.93l3.34,8.83h37.18c0.63,0,1.13,0.51,1.13,1.13l-0.01,5.21h-33.18c-6.26,0-11.34,5.08-11.34,11.34v3.19C213.91,82.33,218.98,87.41,225.24,87.41z M224.53,71.53c0-0.63,0.51-1.13,1.13-1.13h32.76v8.08h-32.76c-0.63,0-1.13-0.51-1.13-1.13V71.53z"/>
                <path d="M395.9,46.37h-26.71V36.13h-0.22h-11.42v51.28h11.64h26.71c6.26,0,11.34-5.08,11.34-11.34V57.71C407.24,51.45,402.16,46.37,395.9,46.37z M395.82,77.36c0,0.63-0.51,1.13-1.13,1.13h-25.5V55.38h25.5c0.63,0,1.13,0.51,1.13,1.13V77.36z"/>
                <polygon points="71.11,153.19 117.59,153.19 117.59,89.8 71.11,71.5"/>
                <polygon points="71.11,22.84 71.11,63.69 117.59,82 117.59,22.84"/>
                <polygon points="17.42,22.84 17.42,104.53 63.89,86.23 63.89,22.84"/>
                <polygon points="17.42,153.19 63.89,153.19 63.89,94.03 17.42,112.34"/>
