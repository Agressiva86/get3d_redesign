                <path d="M336.96,46.37h-57.65v41.04h11.31v-30.9c0-0.63,0.51-1.13,1.13-1.13h15.3c0.63,0,1.13,0.51,1.13,1.13v30.9h11.37v-30.9c0-0.63,0.51-1.13,1.13-1.13h15.08c0.63,0,1.13,0.51,1.13,1.13v30.9h11.39v-29.7C348.3,51.45,343.22,46.37,336.96,46.37z"/>
