---
---
<aside class="cart" id="cart" aria-hidden="true" aria-labelledby="cart-title">
    <div class="cart-head">
      <h2 id="cart-title">Koszyk</h2>
      <button class="icon-btn" type="button" data-close-cart aria-label="Zamknij koszyk">×</button>
    </div>
    <div class="cart-items" id="cart-items"></div>
    <div class="cart-foot">
      <div class="row"><span>Razem</span><strong id="cart-total">0 zł</strong></div>
      <form class="checkout" id="checkout">
        <input name="name" required placeholder="Imię i nazwisko*" aria-label="Imię i nazwisko">
        <input type="email" name="email" required placeholder="E-mail*" aria-label="E-mail">
        <textarea name="note" rows="2" placeholder="Dopisek do zamówienia" aria-label="Dopisek"></textarea>
        <button class="btn btn-red" type="submit">Złóż zamówienie</button>
      </form>
      <p class="form-note" id="order-note" role="status"></p>
    </div>
  </aside>
