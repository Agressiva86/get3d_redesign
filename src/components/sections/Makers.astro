---
const sectionClass = "makers py-[72px] pb-7 max-[760px]:pt-12";

const wrapClass = "mx-auto w-full max-w-[1500px] px-[30px]";

const headClass =
  "makers-head flex items-center justify-between gap-4 max-[760px]:flex-wrap max-[760px]:items-start";

const titleClass =
  "m-0 max-w-[18em] text-[clamp(28px,3vw,40px)] font-semibold leading-[1.15] tracking-normal [&_span]:font-medium [&_span]:text-stone-500";

const navClass =
  "makers-nav flex flex-none gap-2.5 [&_.hero-slider-arrow:disabled]:cursor-default [&_.hero-slider-arrow:disabled]:opacity-35 [&_.hero-slider-arrow:disabled:hover]:bg-white [&_.hero-slider-arrow:disabled:hover]:text-ink";

const trackClass =
  "makers-track mt-7 flex cursor-grab gap-[18px] overflow-x-auto scroll-auto px-[max(30px,calc((100%-var(--container))/2))] pb-3 pt-0.5 [-ms-overflow-style:none] [scrollbar-width:none] touch-pan-x [&::-webkit-scrollbar]:hidden [&.is-grabbing]:cursor-grabbing [&.is-grabbing]:select-none [&.is-grabbing_a]:pointer-events-none";

const unitClass =
  "maker-unit flex flex-[0_0_360px] flex-col text-ink max-[760px]:basis-[min(360px,86vw)]";

const heroClass = "maker-hero block text-inherit no-underline";

const brandClass = "maker-brand bg-white px-0.5 pb-3.5 pt-0";

const nameClass = "maker-name m-0 leading-none";

const logoClass = "maker-logo block h-9 w-auto max-w-[220px] object-contain object-left";

const cardClass =
  "maker-card relative block min-h-[420px] flex-1 overflow-hidden rounded-[22px] bg-stone-200 max-[760px]:min-h-[420px]";

const shotClass =
  "maker-shot absolute inset-0 h-full w-full max-w-none object-cover object-center";

const captionClass =
  "maker-caption absolute inset-x-0 bottom-0 z-[1] flex flex-col items-start gap-2.5 px-5 pb-[18px] pt-[88px] before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:bg-gradient-to-t before:from-[rgba(21,0,41,0.55)] before:from-0% before:via-[rgba(21,0,41,0.32)] before:via-[55%] before:to-transparent before:to-100% before:backdrop-blur-[16px] before:backdrop-saturate-[1.4] before:[mask-image:linear-gradient(to_top,#000_0%,#000_52%,transparent_100%)] before:[-webkit-mask-image:linear-gradient(to_top,#000_0%,#000_52%,transparent_100%)]";

const lineClass = "maker-line relative m-0 text-inherit";

const captionBtnClass = "hero-caption-btn hero-caption-btn-solid";

const productsClass = "maker-products mt-3.5 flex flex-col gap-2 px-0.5";

const productClass =
  "maker-product grid grid-cols-[76px_minmax(0,1fr)] items-center gap-3 rounded-[14px] bg-stone-50 px-3 py-2.5 text-inherit no-underline transition-[background-color,box-shadow] duration-200 ease-out hover:bg-white hover:shadow-[inset_0_0_0_1px_var(--stone-200)] focus-visible:bg-white focus-visible:shadow-[inset_0_0_0_1px_var(--stone-200)]";

const productShotClass =
  "maker-product-shot block aspect-square overflow-hidden rounded-[10px] bg-white [&_img]:h-full [&_img]:w-full [&_img]:object-contain";

const productBodyClass = "maker-product-body flex min-w-0 flex-col items-start gap-1.5";

const productNameClass =
  "maker-product-name block font-heading text-sm font-semibold leading-[1.25] text-ink";

const pricingClass =
  "maker-product-pricing flex w-full flex-col items-start gap-0.5 [&_.mega-currency]:text-xs [&_.mega-low]:m-0 [&_.mega-low]:text-[11px] [&_.mega-low]:leading-[1.35] [&_.mega-price]:text-[22px] [&_.mega-price:not(:has(.mega-save))]:text-stone-900 [&_.mega-price_small]:text-[11px] [&_.mega-price_sup]:-top-[0.65em] [&_.mega-price_sup]:text-[10px] [&_.mega-save]:text-[11px] [&_.mega-save]:leading-[14px]";

const allClass = "mini-link maker-all mt-3 self-start";

const scrollWrapClass = "makers-scroll-wrap mt-4 pb-1";

const scrollClass =
  "makers-scroll h-3.5 overflow-x-auto overflow-y-hidden [scrollbar-color:var(--sb-thumb-color)_var(--sb-track-color)] [scrollbar-width:thin] [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar-button]:hidden [&::-webkit-scrollbar-thumb]:rounded-[15px] [&::-webkit-scrollbar-thumb]:bg-[var(--sb-thumb-color)] [&::-webkit-scrollbar-track]:rounded-[15px] [&::-webkit-scrollbar-track]:bg-[var(--sb-track-color)]";

const spacerClass = "makers-scroll-spacer h-px pointer-events-none";
