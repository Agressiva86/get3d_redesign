---

<section class={sectionClass} id="bestsellery" aria-labelledby="bestsellery-title" data-bestsellery>
  <div class={wrapClass}>
    <div class={layoutClass}>
      <article class="bs-deal">
        <header class="bs-deal-head">
          <h2 class="bs-deal-kicker">Oferta dnia</h2>
          <p class="bs-deal-badge">Oszczędź <strong>{deal.save}&nbsp;zł</strong></p>
        </header>
        <div class="hero-slide">
          <div class="product-shot">
            <img src={deal.img} alt={deal.alt} width="220" height="220" loading="lazy" />
          </div>
          <p class="hero-slide-name">{deal.name}</p>
          <ul class="product-badges">
            {deal.badges.map((badge) => <li>{badge}</li>)}
            <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
          </ul>
          <div class="mega-buy">
            <p class="mega-price">
              <span class="mega-amount">{deal.price}<sup>00</sup> <span class="mega-currency">zł</span></span>
              <span class="mega-save">-{deal.save}&nbsp;zł</span>
            </p>
            <div class="card-actions">
              <a class="mini-link card-details" href={deal.href}>Szczegóły</a>
              <button
                class="mega-cart"
                type="button"
                data-add
                data-id={deal.id}
                data-name={deal.name}
                data-price="990"
              >
                <span class="icon icon-cart" aria-hidden="true"></span> Kup teraz
              </button>
            </div>
            <p class="mega-low">Najniższa cena: {deal.lowest}&nbsp;zł</p>
          </div>
        </div>
        <div class="bs-deal-timer">
          <p class="bs-deal-timer-label">Do końca promocji</p>
          <div class="bs-deal-timer-grid" data-deal-countdown aria-live="polite">
            <div class="bs-deal-timer-unit">
              <span class="bs-deal-timer-num" data-days>00</span>
              <span class="bs-deal-timer-cap">dni</span>
            </div>
            <div class="bs-deal-timer-unit">
              <span class="bs-deal-timer-num" data-hours>00</span>
              <span class="bs-deal-timer-cap">godziny</span>
            </div>
            <div class="bs-deal-timer-unit">
              <span class="bs-deal-timer-num" data-minutes>00</span>
              <span class="bs-deal-timer-cap">minuty</span>
            </div>
          </div>
        </div>
      </article>

      <div class="bs-panel">
        <div class={panelHeadClass}>
          <h2 id="bestsellery-title" class="bs-panel-title">Bestsellery</h2>
          <div class={tabsClass} role="tablist" aria-label="Kategorie bestsellerów" data-bestsellery-tabs>
          <span class="tab-indicator" aria-hidden="true"></span>
          {
            categories.map((cat, index) => (
              <button
                type="button"
                class={`${tabBtnClass}${index === 0 ? " is-active" : ""}`}
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                data-btab={cat.id}
              >
                {cat.label}
              </button>
            ))
          }
          </div>
        </div>
        {
          categories.map((cat, index) => (
            <div class={panelsClass} data-bpanel={cat.id} hidden={index !== 0}>
              <div class="bestsellery-grid" role="list">
                {
                  cat.items.map((product) => (
                    <article class={cardClass} role="listitem">
                      <div class="product-shot">
                        <img src={product.img} alt={product.alt} loading="lazy" />
                        {product.variants ? <span class="variant-count">{product.variants}</span> : null}
                      </div>
                      <p class="hero-slide-name">{product.name}</p>
                      <ul class="product-badges">
                        {product.badges.map((badge) => <li>{badge}</li>)}
                        <li><span class="icon icon-cube" aria-hidden="true"></span> Wysyłamy w 24h</li>
                      </ul>
                      <div class="mega-buy">
                        <p class="mega-price">
                          <span class="mega-amount">
                            {product.from ? <small>od</small> : null}
                            {product.price}<sup>00</sup> <span class="mega-currency">zł</span>
                          </span>
                          {product.save ? <span class="mega-save">-{product.save}&nbsp;zł</span> : null}
                        </p>
                        <div class="card-actions">
                          <a class="mini-link card-details" href={product.href}>Szczegóły</a>
                          {product.buy ? (
                            <button class="mega-cart" type="button" data-add data-id={product.buy.id} data-name={product.buy.name} data-price={product.buy.price}>
                              <span class="icon icon-cart" aria-hidden="true"></span> Kup teraz
                            </button>
                          ) : (
                            <a class="mega-cart mega-cart-variant" href={product.href}>
                              <span class="icon icon-layers" aria-hidden="true"></span> Wybierz wariant
                            </a>
                          )}
                        </div>
                        {product.low ? <p class="mega-low">Najniższa cena: {product.low}&nbsp;zł</p> : null}
                      </div>
                    </article>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector("[data-bestsellery]");
  if (section) {
    const list = section.querySelector("[data-bestsellery-tabs]");
    const tabs = section.querySelectorAll("[data-btab]");
    const panels = section.querySelectorAll("[data-bpanel]");

    const placeTabPill = () => {
      if (!list) return;
      const active = list.querySelector(".is-active");
      const indicator = list.querySelector(".tab-indicator");
      if (!active || !indicator) return;
      indicator.style.width = `${active.offsetWidth}px`;
      indicator.style.height = `${active.offsetHeight}px`;
      indicator.style.transform = `translate(${active.offsetLeft}px, ${active.offsetTop}px)`;
      list.classList.add("has-pill");
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((item) => {
          const on = item === tab;
          item.classList.toggle("is-active", on);
          item.setAttribute("aria-selected", String(on));
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.bpanel !== tab.dataset.btab;
        });
        placeTabPill();
      });
    });

    placeTabPill();
    window.addEventListener("resize", placeTabPill);
    document.fonts?.ready.then(placeTabPill);

    const countdown = section.querySelector("[data-deal-countdown]");
    if (countdown) {
      const end = new Date();
      end.setHours(23, 59, 59, 999);
      const daysEl = countdown.querySelector("[data-days]");
      const hoursEl = countdown.querySelector("[data-hours]");
      const minutesEl = countdown.querySelector("[data-minutes]");
      const pad = (n) => String(n).padStart(2, "0");
      const tick = () => {
        const diff = Math.max(0, end.getTime() - Date.now());
        const d = Math.floor(diff / 86_400_000);
        const h = Math.floor((diff % 86_400_000) / 3_600_000);
        const m = Math.floor((diff % 3_600_000) / 60_000);
        if (daysEl) daysEl.textContent = pad(d);
        if (hoursEl) hoursEl.textContent = pad(h);
        if (minutesEl) minutesEl.textContent = pad(m);
      };
      tick();
      window.setInterval(tick, 1000);
    }
  }
</script>