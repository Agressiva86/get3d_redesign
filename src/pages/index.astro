---
import BaseLayout from "../layouts/BaseLayout.astro";
import SkipLink from "../components/sections/SkipLink.astro";
import Header from "../components/sections/Header.astro";
import Hero from "../components/sections/Hero.astro";
import CatPicks from "../components/sections/CatPicks.astro";
import Bestsellery from "../components/sections/Bestsellery.astro";
import PrintGuide from "../components/sections/PrintGuide.astro";
import BrandSpot from "../components/sections/BrandSpot.astro";
import Makers from "../components/sections/Makers.astro";
import WhyGet3d from "../components/sections/WhyGet3d.astro";
import Faq from "../components/sections/Faq.astro";
import Footer from "../components/sections/Footer.astro";
import SiteOverlay from "../components/sections/SiteOverlay.astro";
import CartDrawer from "../components/sections/CartDrawer.astro";
import CookieConsent from "../components/sections/CookieConsent.astro";
---

<BaseLayout>
  <SkipLink />
  <Header />
  <main id="tresc" class="m-0 overflow-x-clip bg-white">
    <Hero />
    <CatPicks />
    <Bestsellery />
    <PrintGuide />
    <BrandSpot />
    <Makers />
    <WhyGet3d />
    <Faq />
  </main>
  <Footer />
  <SiteOverlay />
  <CartDrawer />
  <CookieConsent />
</BaseLayout>